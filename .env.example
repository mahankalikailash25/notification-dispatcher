# Port the Express server will listen on
PORT=3000

# Path to the SQLite database file (relative to project root)
DB_PATH=./data/dispatcher.db

# Failure simulation rate for the worker (0.1 = 10%)
FAILURE_RATE=0.1

# Min/Max simulated processing delay in milliseconds
MIN_DELAY_MS=500
MAX_DELAY_MS=1000
